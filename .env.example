# Root .env.example — values consumed by docker-compose.yml.
# Copy to `.env` and fill in. Per-service env (e.g. server/.env) is separate
# and only used when running services outside of compose (npm run dev etc.).

# Required: a long random string the server uses to sign JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin allowed by CORS / used in email links.
ALLOWED_ORIGINS=http://localhost:5173
CLIENT_URL=http://localhost:5173

# Backend origin baked into the React bundle at build time.
VITE_API_URL=http://localhost:5000

# Gmail SMTP via nodemailer — leave blank for local dev to fall back to the
# console URL log. Use a Gmail App Password (2-Step Verification required).
SMTP_USER=
SMTP_PASS=

# Claude API key for the Django bug analyzer. Leave blank to fall back to
# keyword matching. Get one at https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
