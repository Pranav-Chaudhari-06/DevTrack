# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ── Database ──────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development default: http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ── Email (Gmail SMTP via nodemailer) ────────────────────────────────────────
# Use a Gmail account with an App Password (https://myaccount.google.com/apppasswords).
# 2-Step Verification must be enabled on the account to generate one.
SMTP_USER=your.gmail.address@gmail.com
SMTP_PASS=your_16_character_app_password

# ── Frontend URL (used in email links) ───────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Bug Analysis Microservice ─────────────────────────────────────────────────
BUG_SERVICE_URL=http://localhost:8000
