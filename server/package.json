{
  "name": "devtrack-server",
  "version": "1.0.0",
  "description": "DevTrack Node.js/Express backend API",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev":   "nodemon index.js",
    "test":  "jest --runInBand"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles":      ["<rootDir>/__tests__/helpers/env.js"],
    "testMatch":       ["<rootDir>/__tests__/**/*.test.js"],
    "testTimeout":     30000
  },
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "nodemailer": "^8.0.5",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.2",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
