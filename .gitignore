# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Environment variables — never commit secrets
.env
server/.env
client/.env

# Python
bug-service/__pycache__/
bug-service/analyzer/__pycache__/
bug-service/bug_service/__pycache__/
bug-service/*.pyc
bug-service/db.sqlite3
bug-service/venv/
bug-service/.venv/
*.pyc
__pycache__/

# Build output
client/dist/
client/.vite/

# Test artifacts
server/coverage/

# OS
.DS_Store
Thumbs.db

# Sensitive files — Dev-Track Password.txt has plaintext creds.
# *.txt is overly broad (would swallow requirements.txt etc.), so we carve
# out exceptions for the files we genuinely want tracked.
*.txt
Dev-Track Password.txt
!bug-service/requirements.txt

# Editor
.vscode/
.idea/
*.swp

# Claude Code
.claude/
